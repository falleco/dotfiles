{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/falleco/projects/notifai/build/Senitsu.app/Contents/MacOS/Senitsu' --integration-hook 'claude-code'",
            "timeout": 600,
            "statusMessage": "Senitsu integration: claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/falleco/projects/notifai/build/Senitsu.app/Contents/MacOS/Senitsu' --integration-hook 'claude-code'",
            "timeout": 3,
            "statusMessage": "Senitsu integration: claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/falleco/projects/notifai/build/Senitsu.app/Contents/MacOS/Senitsu' --integration-hook 'claude-code'",
            "timeout": 3,
            "statusMessage": "Senitsu integration: claude-code"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/falleco/projects/notifai/build/Senitsu.app/Contents/MacOS/Senitsu' --integration-hook 'claude-code'",
            "timeout": 3,
            "statusMessage": "Senitsu integration: claude-code"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true
}
